# Application Configuration
NEXT_PUBLIC_APP_NAME="DAISEE Prospector"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Database - PostgreSQL on Neon (Serverless)
# Use the pooler endpoint for DATABASE_URL (recommended)
# Use the direct endpoint for DIRECT_URL (for migrations)
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.neon.tech/neondb?sslmode=require"

# AI Integration - Claude API
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Authentication (Optional - not implemented yet)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="https://yourdomain.com"
